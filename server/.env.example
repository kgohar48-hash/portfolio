# Copy to .env and fill in for LOCAL development.
# On Render, these are set via render.yaml + the dashboard instead — this
# file isn't deployed (see .gitignore) and PORT is assigned by Render itself.

# Server
# Note: 5000 is used by macOS AirPlay Receiver (ControlCenter) on many Macs —
# 5050 avoids that conflict without needing to disable AirPlay.
PORT=5050
NODE_ENV=development

# Comma-separated list of allowed origins for CORS in production.
# In development the Vite dev server (http://localhost:5173) is always allowed.
CLIENT_ORIGIN=https://goharkhanawan.com,https://www.goharkhanawan.com

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/gohar-portfolio
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>/gohar-portfolio?retryWrites=true&w=majority
# If left blank, the API still runs and contact messages are appended to
# server/data/messages.local.json so nothing is lost.
MONGO_URI=mongodb://127.0.0.1:27017/gohar-portfolio
