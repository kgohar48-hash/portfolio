# Copy to .env and fill in for LOCAL development.
# On Render, these are set via render.yaml + the dashboard instead — this
# file isn't deployed (see .gitignore) and PORT is assigned by Render itself.

# Server
# Note: 5000 is used by macOS AirPlay Receiver (ControlCenter) on many Macs —
# 5050 avoids that conflict without needing to disable AirPlay.
PORT=5050
NODE_ENV=development

# Comma-separated list of allowed origins for CORS in production.
# In development the Vite dev server (http://localhost:5173) is always allowed.
CLIENT_ORIGIN=https://goharawan.com,https://www.goharawan.com

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/gohar-portfolio
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>/gohar-portfolio?retryWrites=true&w=majority
# If left blank, the API still runs and contact messages are appended to
# server/data/messages.local.json so nothing is lost. (Visitor analytics
# require a database — without one, tracking requests are accepted and dropped.)
MONGO_URI=mongodb://127.0.0.1:27017/gohar-portfolio

# --- Admin dashboard (/admin) ---
# The single password that unlocks the analytics dashboard. If unset, /admin
# and all /api/admin/* routes return 503 (feature disabled).
ADMIN_PASSWORD=change-me-to-something-long

# Optional. Secret used to sign the admin session token. If unset, one is
# derived from ADMIN_PASSWORD (so setting just the password above is enough).
# Set this explicitly if you want existing logins to survive a password change.
ADMIN_JWT_SECRET=

# Optional. How long raw per-action events are kept before expiring (the
# rollups on sessions/visitors are kept forever). Default 365.
EVENTS_TTL_DAYS=365

# --- /admin → Inbox tab + CV generator (Gemini) ---
# Free key from https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Status auto-apply threshold for a pasted email (DB MailSettings wins when set).
MAIL_AUTOAPPLY_MIN_CONFIDENCE=0.72
