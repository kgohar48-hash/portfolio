# Copy to .env for a local production-style build/preview (`npm run build && npm run preview`).
# Not needed for `npm run dev` — the Vite dev server proxies /api to localhost:5050 instead.
#
# On Render, this is set as a build-time env var on the static site service
# (see render.yaml) since Vite bakes VITE_* vars in at build time.
VITE_API_BASE=http://localhost:5050
